{
  "name": "bookmark-nav",
  "version": "0.1.0",
  "description": "多功能简洁书签导航站:Fork 后部署到 Cloudflare Workers,支持分类嵌套、私密书签、浏览器书签导入导出、死链检测",
  "license": "GPL-3.0-only",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@hono/zod-validator": "^0.9.0",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "lucide-react": "^1.27.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "remark-breaks": "^4.0.0",
    "shadcn": "^4.16.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.15.3",
    "@eslint/js": "9.39.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/chrome": "^0.2.9",
    "@types/node": "^24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@wxt-dev/module-react": "^1.2.2",
    "better-sqlite3": "^13.0.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.115.0",
    "wxt": "^0.21.4"
  },
  "private": true,
  "scripts": {
    "build": "node scripts/prepare-deploy-config.mjs && tsc -b && vite build",
    "cf-typegen": "wrangler types",
    "check": "tsc -b && vite build && wrangler deploy --dry-run",
    "db:migrate": "wrangler d1 migrations apply bookmark-nav-db --remote",
    "deploy": "npm run db:migrate && wrangler deploy",
    "dev": "vite",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "npm run build && vite preview",
    "dev:ext": "wxt",
    "typecheck:ext": "wxt prepare && tsc -p tsconfig.ext.json --noEmit",
    "build:ext": "wxt -b chrome build",
    "zip:ext": "wxt -b chrome zip",
    "build:ext:firefox": "wxt -b firefox build"
  },
  "type": "module",
  "allowScripts": {
    "esbuild@0.25.4": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.1": true,
    "better-sqlite3@13.0.2": true,
    "workerd@1.20251125.0": true,
    "workerd@1.20260722.1": true
  }
}
